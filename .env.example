# Versão da imagem oficial (https://hub.docker.com/r/strangeloopgames/eco-game-server/tags)
# "latest" acompanha a release atual. Fixe uma versão (ex.: 0.14.0.2-beta) se quiser
# garantir que o servidor não pule de versão sozinho e desencontre da versão dos clientes.
ECO_VERSION=latest

# Autenticação. O servidor se recusa a subir sem uma destas opções:
#   -offline                            -> sem conta, não aparece na lista pública
#   -userToken=SEU_TOKEN                -> token em https://play.eco/account
#   -username=USUARIO -password=SENHA   -> alternativa ao token
ECO_AUTH=JEmh-kHL4+G9qi2U2qW9

# Portas expostas no host
GAME_PORT=3000
WEB_PORT=3001
