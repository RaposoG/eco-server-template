# Image tag — see https://hub.docker.com/r/strangeloopgames/eco-game-server/tags
# "latest" follows the current release. Pin a version (e.g. 0.14.0.2-beta) if you
# want control over when the server updates, since clients must match it.
ECO_VERSION=latest

# Your Eco user token from https://play.eco/account — paste the token only,
# with no flag and no quotes. Leave it empty to run in offline mode: that works
# fine, but the server is not listed publicly and cannot pull mods from mod.io.
ECO_TOKEN=

# Read-only mod.io API key from https://mod.io/me/access, used by
# scripts/fetch-mods.sh to resolve each mod's current file.
MODIO_API_KEY=

# Container memory ceiling. Set it to roughly 75% of the machine's RAM so a spike
# kills the container instead of the host.
MEM_LIMIT=24g

TZ=America/Sao_Paulo

# Ports published on the host
GAME_PORT=3000
WEB_PORT=3001
