.env

# Downloaded mods. Configs/ModKit.eco lists the mod IDs and scripts/fetch-mods.sh
# reproduces both folders, so there is no reason to commit a few hundred MB of
# other people's work. Delete these two lines to ship a repo with the mods included.
mods/
mods-installed/

# Third-party blueprint from mod.io — belongs to its author, not this repo.
blueprints/
